# Local development settings. Copy to ".env" (the app also runs with none of these).
# Leave DATABASE_URL unset to use a local SQLite file (helioops.db).
# DATABASE_URL=postgresql://user:pass@host/dbname
SECRET_KEY=change-me
# Twilio (optional — without these, texts are logged not sent):
# TWILIO_SID=ACxxxxxxxx
# TWILIO_TOKEN=xxxxxxxx
# TWILIO_FROM=+441...
